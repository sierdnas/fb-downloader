# Copy to .env and adapt to your own paths/values.
#
# IMPORTANT: only the variables listed below are actually read by the
# container (explicitly referenced in docker-compose.yml). Filename/folder
# templates, date format, NFO generation, and interface language are NOT
# environment variables: they're configured from the "Settings" tab of
# the web UI (saved to SQLite, persistent across restarts).

# Port exposed on the NAS (host side). The container always listens
# internally on 8686 — change ONLY this value for the external port.
APP_PORT=9797

# Output folder ON THE HOST (your NAS) for VIDEO/REEL — this is the
# ONLY thing you need to change to move where videos end up. Must point
# to the folder Jellyfin sees as the "TV Shows" library.
# NOTE: on Linux paths are case-sensitive — use the EXACT case of your
# real folder (check it with `ls -la /volume2/media/` on the NAS).
OUTPUT_ROOT=/volume2/media/facebook

# Output folder ON THE HOST for PHOTOS — separate from OUTPUT_ROOT:
# Jellyfin doesn't handle photos like videos (no NFO/show/season data),
# so they live in a completely distinct folder tree, to be linked to a
# separate Jellyfin library of type "Photos".
PHOTO_OUTPUT_ROOT=/volume2/media/facebook-photos

# Web UI authentication (HTTP Basic, native browser prompt).
# Leaving ADMIN_PASSWORD empty, the app stays WITHOUT login (default
# behavior). Set it to protect access, especially if you expose the app
# beyond your Tailscale network.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Do NOT add a MEDIA_ROOT or PHOTO_MEDIA_ROOT here: the container-side
# paths are fixed and already set in docker-compose.yml, so they can no
# longer go out of sync with the volumes.

# --- Configurable ONLY from the web UI (Settings tab), not from here ---
# Default filename template: {date}_{id} (just date-time + Facebook ID,
#   no post text — that goes in the description/.nfo)
# Default date format: %Y-%m-%d-%H-%M (includes hour/minutes)
# Default video/reel folder: {profile}/Stagione {season}
# Default photo folder: {profile} (inside the dedicated photo root)
# Generate .nfo for Jellyfin: enabled by default (video/reel only)
# Default interface language: English (en)
